# Copy to .env and fill in:  cp .env.example .env
# docker compose reads .env automatically. Never commit .env.

# Required: base URL of the registry the backend talks to.
REGISTRY_URL=https://registry.example.com

# Basic-auth credentials for the registry (leave empty if it has no auth).
REGISTRY_USER=
REGISTRY_PASSWORD=

# Host shown in "docker pull" commands (default: host of REGISTRY_URL).
REGISTRY_PUBLIC_HOST=

# Verify the registry TLS certificate (default: true).
#REGISTRY_VERIFY_TLS=true

# Max parallel requests to the registry (default: 16).
#REGISTRY_CONCURRENCY=16

# Set to false for a read-only UI (default: true).
#DELETE_ENABLED=true

# Filesystem storage root of the registry, mounted into the container.
# Enables deleting empty repositories (see README). Also set "user" and
# "volumes" in docker-compose.yml.
#REGISTRY_STORAGE_PATH=/var/lib/registry

#LOG_LEVEL=INFO
